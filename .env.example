# ---- Vendor-risk mock service (started by run_local.py) ----
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# ---- Model provider ----
# groq (default) | none  (none = deterministic policy output only, no model calls)
LLM_PROVIDER=groq
# Model used for both architectures. Must support tool calling + JSON output on Groq.
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45

# Put real keys in .env (git-ignored), never in this file.
# One key is enough. Extra keys (GROQ_API_KEY_2, ...) are standby credentials that are only
# used if the first key is rejected as invalid; they are NOT rotated to bypass rate limits.
GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEYS=key_a,key_b      # alternative comma-separated form
